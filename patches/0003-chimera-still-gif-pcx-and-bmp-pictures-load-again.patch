From: Sergio Martin
Subject: [PATCH] chimera: still GIF, PCX and BMP pictures load again

Upstream removed still GIF, PCX and BMP pictures on 2026-06-01 (bd1033d5)
and kept PNG only. Games made for older OpenBOR builds use those formats
for sprites, backgrounds and fonts, and stopped with "Unable to load image
file" (ToolAssisted-run/chimera#342). The readers come back as they were
before the removal, writing the engine's 32-bit palette as the PNG reader
does; a picture named without an extension is looked for as .png, then
.gif, .pcx and .bmp, as before. The shadow and arrow sprites are looked for
as .gif when there is no .png, as before; a game whose shadows are GIF
crashed drawing one that never loaded.
---
diff --git a/engine/openbor.c b/engine/openbor.c
--- a/engine/openbor.c
+++ b/engine/openbor.c
@@ -6615,6 +6615,22 @@
                                               sprite_load->y_offset,
                                               pixelformat);
         }
+        // chimera: as before upstream's 2026-06-01 change, the same name as a
+        // .gif when there is no .png (chimera#342). A game for older builds
+        // has its shadows as GIF, and drawing a shadow that never loaded
+        // crashed.
+        else {
+            char gif_path[MAX_BUFFER_LEN];
+            size_t length = strlen(sprite_load->path);
+
+            snprintf(gif_path, sizeof(gif_path), "%.*s.gif", (int)(length - 4), sprite_load->path);
+            if(testpackfile(gif_path, packfile) >= 0) {
+                *sprite_load->sprite = loadsprite(gif_path,
+                                                  sprite_load->x_offset,
+                                                  sprite_load->y_offset,
+                                                  pixelformat);
+            }
+        }
     }
 
     /*
diff --git a/engine/source/gamelib/loadimg.c b/engine/source/gamelib/loadimg.c
index 92e80672..313d0d23 100644
--- a/engine/source/gamelib/loadimg.c
+++ b/engine/source/gamelib/loadimg.c
@@ -597,6 +597,641 @@ readpng_abort:
 }
 
 // ============================== auto loading ===============================
+// ============================== GIF, PCX and BMP loading ===============================
+// chimera: still GIF, PCX and BMP pictures. Upstream removed them on
+// 2026-06-01 (bd1033d5), and games made for older OpenBOR builds, which use
+// them for sprites and backgrounds, stopped loading
+// (ToolAssisted-run/chimera#342). These are the readers as they were before
+// the removal, with three changes: they write the engine's 32-bit palette as
+// the PNG reader does, a GIF's local palette is read and converted rather
+// than copied raw, and a BMP's rows step by the file's own row length, which
+// is padded to four bytes. A PCX picture is xmax by ymax pixels, one less
+// each way than the file holds, as it always was in OpenBOR.
+
+#pragma pack(push, 1)
+
+typedef struct
+{
+    unsigned short  bm;
+    int             filesize;
+    int             reserved;
+    int             picstart;
+    int             headersize;
+    int             xsize;
+    int             ysize;
+    unsigned short  numplanes;
+    unsigned short  bpp;
+    int             compression;
+    int             picsize;
+    int             hres;
+    int             vres;
+    int             numcolors_used;
+    int             numcolors_important;
+} s_bmpheader;
+
+typedef struct
+{
+    char            magic[6];
+    unsigned short  screenwidth, screenheight;
+    unsigned char   flags;
+    unsigned char   background;
+    unsigned char   aspect;
+} gifheaderstruct;
+
+typedef struct
+{
+    unsigned short  left, top, width, height;
+    unsigned char   flags;
+} gifblockstruct;
+
+typedef struct
+{
+    char            manufacturer;
+    char            version;
+    char            encoding;
+    char            bitspp;
+    unsigned short  xmin, ymin;
+    unsigned short  xmax, ymax;
+    unsigned short  hres, vres;
+    char            unused[48];
+    char            reserved;
+    char            colorplanes;
+    unsigned short  bytesperline;
+    unsigned short  paltype;
+    char            unused2[58];
+} s_pcxheader;
+
+#pragma pack(pop)
+
+static s_bmpheader bmp_header;
+static gifheaderstruct gif_header;
+static s_pcxheader pcx_header;
+
+static void close_legacy_image(void)
+{
+    if(image_load_handle >= 0)
+    {
+        closepackfile(image_load_handle);
+    }
+    image_load_handle = HANDLE_UNUSED;
+}
+
+// RGB triplets into the engine's 32-bit palette; entries not given are black
+static void legacy_palette(unsigned char *pal, const unsigned char *rgb, int colours)
+{
+    unsigned *pal32 = (unsigned *)pal;
+    int i;
+
+    for(i = 0; i < 256; i++)
+    {
+        pal32[i] = i < colours ? colour32(rgb[i * 3], rgb[i * 3 + 1], rgb[i * 3 + 2]) : 0;
+    }
+}
+
+// ------------------------------ BMP ------------------------------
+
+static int openbmp(char *filename, char *packfilename)
+{
+    if((image_load_handle = openpackfile(filename, packfilename)) == -1)
+    {
+        image_load_handle = HANDLE_UNUSED;
+        return 0;
+    }
+    if(readpackfile(image_load_handle, &bmp_header, sizeof(s_bmpheader)) != sizeof(s_bmpheader))
+    {
+        close_legacy_image();
+        return 0;
+    }
+    bmp_header.bm = SwapLSB16(bmp_header.bm);
+    bmp_header.numplanes = SwapLSB16(bmp_header.numplanes);
+    bmp_header.bpp = SwapLSB16(bmp_header.bpp);
+    bmp_header.filesize = SwapLSB32(bmp_header.filesize);
+    bmp_header.reserved = SwapLSB32(bmp_header.reserved);
+    bmp_header.picstart = SwapLSB32(bmp_header.picstart);
+    bmp_header.headersize = SwapLSB32(bmp_header.headersize);
+    bmp_header.xsize = SwapLSB32(bmp_header.xsize);
+    bmp_header.ysize = SwapLSB32(bmp_header.ysize);
+    bmp_header.compression = SwapLSB32(bmp_header.compression);
+    bmp_header.picsize = SwapLSB32(bmp_header.picsize);
+    bmp_header.hres = SwapLSB32(bmp_header.hres);
+    bmp_header.vres = SwapLSB32(bmp_header.vres);
+    bmp_header.numcolors_used = SwapLSB32(bmp_header.numcolors_used);
+    bmp_header.numcolors_important = SwapLSB32(bmp_header.numcolors_important);
+
+    if(bmp_header.bm != 0x4D42 || bmp_header.bpp != 8 || bmp_header.compression
+        || bmp_header.xsize <= 0 || bmp_header.ysize <= 0 || bmp_header.picstart < 1024)
+    {
+        close_legacy_image();
+        return 0;
+    }
+    image_res.width = bmp_header.xsize;
+    image_res.height = bmp_header.ysize;
+    return 1;
+}
+
+static int readbmp(unsigned char *buf, unsigned char *pal, int maxwidth, int maxheight)
+{
+    unsigned char quad[1024];
+    unsigned char rgb[768];
+    int stride = (bmp_header.xsize + 3) & ~3;
+    int width = bmp_header.xsize < maxwidth ? bmp_header.xsize : maxwidth;
+    int y, i;
+
+    if(buf)
+    {
+        for(y = 0; y < maxheight && y < bmp_header.ysize; y++)
+        {
+            // the rows are stored bottom up
+            seekpackfile(image_load_handle, bmp_header.picstart + (bmp_header.ysize - y - 1) * stride, SEEK_SET);
+            if(readpackfile(image_load_handle, buf + y * maxwidth, width) != width)
+            {
+                return 0;
+            }
+        }
+    }
+
+    if(pal)
+    {
+        seekpackfile(image_load_handle, bmp_header.picstart - 1024, SEEK_SET);
+        if(readpackfile(image_load_handle, quad, 1024) != 1024)
+        {
+            return 0;
+        }
+        // blue, green, red, unused
+        for(i = 0; i < 256; i++)
+        {
+            rgb[i * 3] = quad[i * 4 + 2];
+            rgb[i * 3 + 1] = quad[i * 4 + 1];
+            rgb[i * 3 + 2] = quad[i * 4];
+        }
+        legacy_palette(pal, rgb, 256);
+    }
+    return 1;
+}
+
+// ------------------------------ GIF ------------------------------
+
+static unsigned char readbyte(int handle)
+{
+    unsigned char c = 0;
+    readpackfile(handle, &c, 1);
+    return c;
+}
+
+#define NO_CODE -1
+
+static int decodegifblock(int handle, unsigned char *buf, int width, int height, unsigned char bits, gifblockstruct *gb)
+{
+    short bits2;
+    short codesize;
+    short codesize2;
+    short nextcode;
+    short thiscode;
+    short oldtoken;
+    short currentcode;
+    short oldcode;
+    short bitsleft;
+    short blocksize;
+    int line = 0;
+    int byte = gb->left;
+    int pass = 0;
+
+    unsigned char *p;
+    unsigned char *u;
+
+    unsigned char *q;
+    unsigned char b[255];
+    unsigned char *linebuffer;
+
+    static unsigned char firstcodestack[4096];
+    static unsigned char lastcodestack[4096];
+    static short codestack[4096];
+
+    static short wordmasktable[] = {    0x0000, 0x0001, 0x0003, 0x0007,
+                                        0x000f, 0x001f, 0x003f, 0x007f,
+                                        0x00ff, 0x01ff, 0x03ff, 0x07ff,
+                                        0x0fff, 0x1fff, 0x3fff, 0x7fff
+                                   };
+
+    static short inctable[] = { 8, 8, 4, 2, 0 };
+    static short startable[] = { 0, 4, 2, 1, 0 };
+
+    p = q = b;
+    bitsleft = 8;
+
+    if (bits < 2 || bits > 8)
+    {
+        return 0;    // Bad symbol
+    }
+    bits2 = 1 << bits;
+    nextcode = bits2 + 2;
+    codesize2 = 1 << (codesize = bits + 1);
+    oldcode = oldtoken = NO_CODE;
+
+    linebuffer = buf + (gb->top * width);
+
+    // loop until something breaks
+    for(;;)
+    {
+        if(bitsleft == 8)
+        {
+            if(++p >= q && (((blocksize = (unsigned char)readbyte(handle)) < 1) ||
+                            (q = (p = b) + readpackfile(handle, b, blocksize)) < (b + blocksize)))
+            {
+                return 0;        // Unexpected EOF
+            }
+            bitsleft = 0;
+        }
+        thiscode = *p;
+        if((currentcode = (codesize + bitsleft)) <= 8)
+        {
+            *p >>= codesize;
+            bitsleft = currentcode;
+        }
+        else
+        {
+            if(++p >= q && (((blocksize = (unsigned char)readbyte(handle)) < 1) ||
+                            (q = (p = b) + readpackfile(handle, b, blocksize)) < (b + blocksize)))
+            {
+                return 0;        // Unexpected EOF
+            }
+
+            thiscode |= *p << (8 - bitsleft);
+            if(currentcode <= 16)
+            {
+                *p >>= (bitsleft = currentcode - 8);
+            }
+            else
+            {
+                if(++p >= q && (((blocksize = (unsigned char)readbyte(handle)) < 1) ||
+                                (q = (p = b) + readpackfile(handle, b, blocksize)) < (b + blocksize)))
+                {
+                    return 0;    // Unexpected EOF
+                }
+
+                thiscode |= *p << (16 - bitsleft);
+                *p >>= (bitsleft = currentcode - 16);
+            }
+        }
+        thiscode &= wordmasktable[codesize];
+        currentcode = thiscode;
+
+        if(thiscode == (bits2 + 1))
+        {
+            break;
+        }
+        if(thiscode > nextcode)
+        {
+            return 0;    // Bad code
+        }
+
+        if(thiscode == bits2)
+        {
+            nextcode = bits2 + 2;
+            codesize2 = 1 << (codesize = (bits + 1));
+            oldtoken = oldcode = NO_CODE;
+            continue;
+        }
+
+        u = firstcodestack;
+
+        if(thiscode == nextcode)
+        {
+            if(oldcode == NO_CODE)
+            {
+                return 0;    // Bad code
+            }
+            *u++ = oldtoken;
+            thiscode = oldcode;
+        }
+
+        while(thiscode >= bits2)
+        {
+            *u++ = lastcodestack [thiscode];
+            thiscode = codestack[thiscode];
+        }
+
+        oldtoken = thiscode;
+        do
+        {
+            if(byte < width && line < (height - gb->top))
+            {
+                linebuffer[byte] = thiscode;
+            }
+            byte++;
+            if(byte >= gb->left + gb->width)
+            {
+                byte = gb->left;
+                // check for interlaced image
+                if(gb->flags & 0x40)
+                {
+                    line += inctable[pass];
+                    if(line >= gb->height)
+                    {
+                        line = startable[++pass];
+                    }
+                }
+                else
+                {
+                    ++line;
+                }
+                linebuffer = buf + (width * (gb->top + line));
+            }
+            if (u <= firstcodestack)
+            {
+                break;
+            }
+            thiscode = *--u;
+        }
+        while(1);
+
+        if(nextcode < 4096 && oldcode != NO_CODE)
+        {
+            codestack[nextcode] = oldcode;
+            lastcodestack[nextcode] = oldtoken;
+            if(++nextcode >= codesize2 && codesize < 12)
+            {
+                codesize2 = 1 << ++codesize;
+            }
+        }
+        oldcode = currentcode;
+    }
+    return 1;
+}
+
+static void passgifblock(int handle)
+{
+    int len;
+
+    // Discard extension function code
+    len = readbyte(handle);
+    // Skip all contained blocks
+    while((len = readbyte(handle)) != 0)
+    {
+        seekpackfile(handle, len, SEEK_CUR);
+    }
+}
+
+static int opengif(char *filename, char *packfilename)
+{
+    if((image_load_handle = openpackfile(filename, packfilename)) == -1)
+    {
+        image_load_handle = HANDLE_UNUSED;
+        return 0;
+    }
+    if(readpackfile(image_load_handle, &gif_header, sizeof(gifheaderstruct)) != sizeof(gifheaderstruct))
+    {
+        close_legacy_image();
+        return 0;
+    }
+    if(gif_header.magic[0] != 'G' || gif_header.magic[1] != 'I' || gif_header.magic[2] != 'F')
+    {
+        // Not a GIF file!
+        close_legacy_image();
+        return 0;
+    }
+
+    gif_header.screenwidth = SwapLSB16(gif_header.screenwidth);
+    gif_header.screenheight = SwapLSB16(gif_header.screenheight);
+
+    image_res.width = gif_header.screenwidth;
+    image_res.height = gif_header.screenheight;
+    return 1;
+}
+
+static int readgif(unsigned char *buf, unsigned char *pal, int maxwidth, int maxheight)
+{
+    gifblockstruct iblock;
+    unsigned char rgb[768];
+    int numcolours = 1 << ((gif_header.flags & 7) + 1);
+    int localcolours;
+    int done = 0;
+    unsigned char c;
+
+    // the global palette, if present and wanted
+    if(gif_header.flags & 0x80)
+    {
+        if(pal)
+        {
+            if(readpackfile(image_load_handle, rgb, numcolours * 3) != numcolours * 3)
+            {
+                return 0;
+            }
+            legacy_palette(pal, rgb, numcolours);
+        }
+        else
+        {
+            seekpackfile(image_load_handle, numcolours * 3, SEEK_CUR);
+        }
+    }
+
+    if(!buf)
+    {
+        return 1;
+    }
+
+    // step through the blocks
+    while(!done)
+    {
+        if(readpackfile(image_load_handle, &c, 1) != 1)
+        {
+            break;
+        }
+        switch(c)
+        {
+        case ',':        // An image block
+
+            if(readpackfile(image_load_handle, &iblock, sizeof(iblock)) != sizeof(iblock))
+            {
+                return 0;
+            }
+
+            iblock.left = SwapLSB16(iblock.left);
+            iblock.top = SwapLSB16(iblock.top);
+            iblock.width = SwapLSB16(iblock.width);
+            iblock.height = SwapLSB16(iblock.height);
+
+            // a local palette, if present: wanted, or read past
+            if(iblock.flags & 0x80)
+            {
+                localcolours = 1 << ((iblock.flags & 7) + 1);
+                if(pal)
+                {
+                    if(readpackfile(image_load_handle, rgb, localcolours * 3) != localcolours * 3)
+                    {
+                        return 0;
+                    }
+                    legacy_palette(pal, rgb, localcolours);
+                }
+                else
+                {
+                    seekpackfile(image_load_handle, localcolours * 3, SEEK_CUR);
+                }
+            }
+
+            // get the initial LZW code bits
+            if(readpackfile(image_load_handle, &c, 1) != 1)
+            {
+                return 0;
+            }
+            if(c < 2 || c > 8)
+            {
+                return 0;
+            }
+            if(!decodegifblock(image_load_handle, buf, maxwidth, maxheight, c, &iblock))
+            {
+                return 0;
+            }
+            break;
+        case '!':
+            // Extension block, read past it
+            passgifblock(image_load_handle);
+            break;
+        case 0:
+            break;
+        default:
+            done = 1;
+        }
+    }
+    return 1;
+}
+
+// ------------------------------ PCX ------------------------------
+
+static int openpcx(char *filename, char *packname)
+{
+    if((image_load_handle = openpackfile(filename, packname)) == -1)
+    {
+        image_load_handle = HANDLE_UNUSED;
+        return 0;
+    }
+    if(readpackfile(image_load_handle, &pcx_header, 128) != 128)
+    {
+        close_legacy_image();
+        return 0;
+    }
+
+    pcx_header.xmin = SwapLSB16(pcx_header.xmin);
+    pcx_header.ymin = SwapLSB16(pcx_header.ymin);
+    pcx_header.xmax = SwapLSB16(pcx_header.xmax);
+    pcx_header.ymax = SwapLSB16(pcx_header.ymax);
+    pcx_header.hres = SwapLSB16(pcx_header.hres);
+    pcx_header.vres = SwapLSB16(pcx_header.vres);
+    pcx_header.bytesperline = SwapLSB16(pcx_header.bytesperline);
+    pcx_header.paltype = SwapLSB16(pcx_header.paltype);
+
+    if(pcx_header.colorplanes == 3 || pcx_header.bytesperline == 0)
+    {
+        close_legacy_image();
+        return 0;
+    }
+
+    image_res.width = pcx_header.xmax;
+    image_res.height = pcx_header.ymax;
+    return 1;
+}
+
+static int readpcx(unsigned char *buf, unsigned char *pal, int maxwidth, int maxheight)
+{
+    unsigned char *codebuffer;
+    unsigned char rgb[768];
+    unsigned int i;
+    unsigned x, y;
+    unsigned spos;        // Searchpos (file)
+    unsigned cpos;        // codepos
+    unsigned dpos;        // Destination
+    unsigned char repbyte;
+    int got;
+
+    if(buf)
+    {
+        if(!(codebuffer = (unsigned char *)malloc(64000)))
+        {
+            return 0;
+        }
+
+        x = 0;
+        y = 0;
+        spos = 0;
+        dpos = 0;
+
+        while(y <= pcx_header.ymax && y < (unsigned)maxheight)
+        {
+            seekpackfile(image_load_handle, 128 + spos, SEEK_SET);
+
+            got = readpackfile(image_load_handle, codebuffer, 64000);
+            if(got <= 0)
+            {
+                free(codebuffer);
+                return 0;
+            }
+            if(got < 64000)
+            {
+                memset(codebuffer + got, 0, 64000 - got);
+            }
+
+            cpos = 0;
+
+            while(cpos < 63990 && y <= pcx_header.ymax && y < (unsigned)maxheight)
+            {
+                if(codebuffer[cpos] > 192)
+                {
+                    i = codebuffer[cpos] - 192;
+                    repbyte = codebuffer[cpos + 1];
+                    do
+                    {
+                        if(x < (unsigned)maxwidth)
+                        {
+                            buf[dpos] = repbyte;
+                        }
+                        ++dpos;
+                        if((++x) >= pcx_header.bytesperline)
+                        {
+                            x = 0;
+                            ++y;
+                            dpos = y * maxwidth;
+                            if(y > pcx_header.ymax || y >= (unsigned)maxheight)
+                            {
+                                break;
+                            }
+                        }
+                    }
+                    while(--i);
+                    cpos += 2;
+                }
+                else
+                {
+                    if(x < (unsigned)maxwidth)
+                    {
+                        buf[dpos] = codebuffer[cpos];
+                    }
+                    ++cpos;
+                    ++dpos;
+                    if((++x) >= pcx_header.bytesperline)
+                    {
+                        x = 0;
+                        ++y;
+                        dpos = y * maxwidth;
+                    }
+                }
+            }
+            spos += cpos;
+        }
+        free(codebuffer);
+    }
+
+    if(pal)
+    {
+        seekpackfile(image_load_handle, -768, SEEK_END);
+        if(readpackfile(image_load_handle, rgb, 768) != 768)
+        {
+            return 0;
+        }
+        legacy_palette(pal, rgb, 256);
+    }
+    return 1;
+}
+
 /*
 * Caskey, Damon V.
 * Simplified still image loader to PNG only 2026-06-01.
@@ -609,7 +1244,11 @@ readpng_abort:
 */
 typedef enum open_type_enum {
     OT_NONE = 0,
-    OT_PNG
+    OT_PNG,
+    // chimera: the formats upstream removed (chimera#342)
+    OT_GIF,
+    OT_PCX,
+    OT_BMP
 } open_type_enum;
     
 static open_type_enum open_type = OT_NONE;
@@ -697,6 +1336,29 @@ static int openimage(char *filename, char *packfile) {
             return 0;
         }
 
+        // chimera: the formats upstream removed (chimera#342)
+        if(stricmp(ext, ".gif") == 0) {
+            if(opengif(filename, packfile)) {
+                open_type = OT_GIF;
+                return 1;
+            }
+            return 0;
+        }
+        if(stricmp(ext, ".pcx") == 0) {
+            if(openpcx(filename, packfile)) {
+                open_type = OT_PCX;
+                return 1;
+            }
+            return 0;
+        }
+        if(stricmp(ext, ".bmp") == 0) {
+            if(openbmp(filename, packfile)) {
+                open_type = OT_BMP;
+                return 1;
+            }
+            return 0;
+        }
+
         printf("\n\n Error: Unsupported image format '%s' for file '%s'. Use non-interlaced indexed PNG images.\n", ext, filename);
         return 0;
     }
@@ -713,6 +1375,26 @@ static int openimage(char *filename, char *packfile) {
         return 1;
     }
 
+    // chimera: then the formats upstream removed, in the order it tried
+    // them before (chimera#342)
+    snprintf(fnam, sizeof(fnam), "%s.gif", filename);
+    if(opengif(fnam, packfile)) {
+        open_type = OT_GIF;
+        return 1;
+    }
+
+    snprintf(fnam, sizeof(fnam), "%s.pcx", filename);
+    if(openpcx(fnam, packfile)) {
+        open_type = OT_PCX;
+        return 1;
+    }
+
+    snprintf(fnam, sizeof(fnam), "%s.bmp", filename);
+    if(openbmp(fnam, packfile)) {
+        open_type = OT_BMP;
+        return 1;
+    }
+
