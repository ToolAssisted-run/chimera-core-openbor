From: Sergio Martin
Subject: [PATCH] chimera: players 2 to 4 have keys by default

Upstream gives players 2 to 4 no controls by default (clearbuttons), and
its defines for them name the first joysticks. The sandbox has no
joysticks, so they get keys, as player 1 has: the core presses those keys
for its player 2 to 4 controls.
---
diff --git a/engine/openbor.c b/engine/openbor.c
index ba010e9c..e6b63d5d 100644
--- a/engine/openbor.c
+++ b/engine/openbor.c
@@ -2838,17 +2838,17 @@ void clearbuttons(int player)
     }
     else if (player == 1)
     {
-        savedata.keys[1][SDID_MOVEUP]    = CONTROL_NONE; //Kratus (20-04-21) Used to clear all keys
-        savedata.keys[1][SDID_MOVEDOWN]  = CONTROL_NONE;
-        savedata.keys[1][SDID_MOVELEFT]  = CONTROL_NONE;
-        savedata.keys[1][SDID_MOVERIGHT] = CONTROL_NONE;
-        savedata.keys[1][SDID_ATTACK]    = CONTROL_NONE;
-        savedata.keys[1][SDID_ATTACK2]   = CONTROL_NONE;
-        savedata.keys[1][SDID_ATTACK3]   = CONTROL_NONE;
-        savedata.keys[1][SDID_ATTACK4]   = CONTROL_NONE;
-        savedata.keys[1][SDID_JUMP]      = CONTROL_NONE;
-        savedata.keys[1][SDID_SPECIAL]   = CONTROL_NONE;
-        savedata.keys[1][SDID_START]     = CONTROL_NONE;
+        savedata.keys[1][SDID_MOVEUP]    = CONTROL_DEFAULT2_UP; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_MOVEDOWN]  = CONTROL_DEFAULT2_DOWN; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_MOVELEFT]  = CONTROL_DEFAULT2_LEFT; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_MOVERIGHT] = CONTROL_DEFAULT2_RIGHT; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_ATTACK]    = CONTROL_DEFAULT2_FIRE1; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_ATTACK2]   = CONTROL_DEFAULT2_FIRE2; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_ATTACK3]   = CONTROL_DEFAULT2_FIRE3; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_ATTACK4]   = CONTROL_DEFAULT2_FIRE4; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_JUMP]      = CONTROL_DEFAULT2_FIRE5; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_SPECIAL]   = CONTROL_DEFAULT2_FIRE6; // chimera: keys, as player 1 has
+        savedata.keys[1][SDID_START]     = CONTROL_DEFAULT2_START; // chimera: keys, as player 1 has
         savedata.keys[1][SDID_SCREENSHOT] = CONTROL_NONE;
         #ifdef SDL
             //savedata.keys[1][SDID_ESC]       = CONTROL_DEFAULT2_ESC;
@@ -2856,17 +2856,17 @@ void clearbuttons(int player)
     }
     else if (player == 2)
     {
-        savedata.keys[2][SDID_MOVEUP]    = CONTROL_NONE; //Kratus (20-04-21) Used to clear all keys
-        savedata.keys[2][SDID_MOVEDOWN]  = CONTROL_NONE;
-        savedata.keys[2][SDID_MOVELEFT]  = CONTROL_NONE;
-        savedata.keys[2][SDID_MOVERIGHT] = CONTROL_NONE;
-        savedata.keys[2][SDID_ATTACK]    = CONTROL_NONE;
-        savedata.keys[2][SDID_ATTACK2]   = CONTROL_NONE;
-        savedata.keys[2][SDID_ATTACK3]   = CONTROL_NONE;
-        savedata.keys[2][SDID_ATTACK4]   = CONTROL_NONE;
-        savedata.keys[2][SDID_JUMP]      = CONTROL_NONE;
-        savedata.keys[2][SDID_SPECIAL]   = CONTROL_NONE;
-        savedata.keys[2][SDID_START]     = CONTROL_NONE;
+        savedata.keys[2][SDID_MOVEUP]    = CONTROL_DEFAULT3_UP; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_MOVEDOWN]  = CONTROL_DEFAULT3_DOWN; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_MOVELEFT]  = CONTROL_DEFAULT3_LEFT; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_MOVERIGHT] = CONTROL_DEFAULT3_RIGHT; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_ATTACK]    = CONTROL_DEFAULT3_FIRE1; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_ATTACK2]   = CONTROL_DEFAULT3_FIRE2; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_ATTACK3]   = CONTROL_DEFAULT3_FIRE3; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_ATTACK4]   = CONTROL_DEFAULT3_FIRE4; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_JUMP]      = CONTROL_DEFAULT3_FIRE5; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_SPECIAL]   = CONTROL_DEFAULT3_FIRE6; // chimera: keys, as player 1 has
+        savedata.keys[2][SDID_START]     = CONTROL_DEFAULT3_START; // chimera: keys, as player 1 has
         savedata.keys[2][SDID_SCREENSHOT] = CONTROL_NONE;
         #ifdef SDL
             //savedata.keys[2][SDID_ESC]       = CONTROL_DEFAULT3_ESC;
@@ -2874,17 +2874,17 @@ void clearbuttons(int player)
     }
     else if (player == 3)
     {
-        savedata.keys[3][SDID_MOVEUP]    = CONTROL_NONE; //Kratus (20-04-21) Used to clear all keys
-        savedata.keys[3][SDID_MOVEDOWN]  = CONTROL_NONE;
-        savedata.keys[3][SDID_MOVELEFT]  = CONTROL_NONE;
-        savedata.keys[3][SDID_MOVERIGHT] = CONTROL_NONE;
-        savedata.keys[3][SDID_ATTACK]    = CONTROL_NONE;
-        savedata.keys[3][SDID_ATTACK2]   = CONTROL_NONE;
-        savedata.keys[3][SDID_ATTACK3]   = CONTROL_NONE;
-        savedata.keys[3][SDID_ATTACK4]   = CONTROL_NONE;
-        savedata.keys[3][SDID_JUMP]      = CONTROL_NONE;
-        savedata.keys[3][SDID_SPECIAL]   = CONTROL_NONE;
-        savedata.keys[3][SDID_START]     = CONTROL_NONE;
+        savedata.keys[3][SDID_MOVEUP]    = CONTROL_DEFAULT4_UP; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_MOVEDOWN]  = CONTROL_DEFAULT4_DOWN; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_MOVELEFT]  = CONTROL_DEFAULT4_LEFT; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_MOVERIGHT] = CONTROL_DEFAULT4_RIGHT; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_ATTACK]    = CONTROL_DEFAULT4_FIRE1; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_ATTACK2]   = CONTROL_DEFAULT4_FIRE2; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_ATTACK3]   = CONTROL_DEFAULT4_FIRE3; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_ATTACK4]   = CONTROL_DEFAULT4_FIRE4; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_JUMP]      = CONTROL_DEFAULT4_FIRE5; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_SPECIAL]   = CONTROL_DEFAULT4_FIRE6; // chimera: keys, as player 1 has
+        savedata.keys[3][SDID_START]     = CONTROL_DEFAULT4_START; // chimera: keys, as player 1 has
         savedata.keys[3][SDID_SCREENSHOT] = CONTROL_NONE;
         #ifdef SDL
             //savedata.keys[3][SDID_ESC]       = CONTROL_DEFAULT4_ESC;
diff --git a/engine/sdl/control.h b/engine/sdl/control.h
index 8593fb1b..8fc5313c 100644
--- a/engine/sdl/control.h
+++ b/engine/sdl/control.h
@@ -10,6 +10,7 @@
 #define	CONTROL_H
 
 // Generic control stuff (keyboard+joystick).
+// chimera: players 2 to 4 have keys by default, as player 1 does (no joysticks in the sandbox)
 #include <SDL_keycode.h>
 #include "joysticks.h"
 
@@ -28,45 +29,45 @@
