{
  "coreName": "OpenBOR",
  "systemId": "OpenBOR",
  "systemNames": {
    "OpenBOR": "OpenBOR"
  },
  "author": "The OpenBOR Team (DCurrent/openbor; Beats of Rage by Senile Team); chimera core by Sergio Martin",
  "url": "https://github.com/DCurrent/openbor",
  "romFile": "game",
  "extensions": {
    ".pak": "OpenBOR"
  },
  "_comment_extensions": "An OpenBOR game is a .pak file (its data folder packed); the engine is the core.",
  "deterministic": true,
  "memoryLayoutMiB": [
    512,
    16,
    16,
    16,
    1024
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. OpenBOR's own memory (the game's sprites, models, levels, scripts and sounds, loaded from the .pak) and SDL's; the .pak itself is read from the file Chimera mounted. The game's stack (8 MiB) is mmap'd.",
  "video": {
    "_comment": "What OpenBOR draws, read back from its renderer when it presents: the game's resolution (320x240 by default, 480x272 and others as the game sets) times its scale. Capacity here is the largest allowed.",
    "width": 1920,
    "height": 1080,
    "getBgra": "GetVideoBgra",
    "vsyncNumerator": 60,
    "vsyncDenominator": 1
  },
  "audio": {
    "_comment": "OpenBOR's own mixer (its music and sound effects), run for exactly one frame's share of a second each frame: 735 stereo samples at 44100 Hz.",
    "sampleRate": 44100,
    "channels": 2,
    "samplesPerFrame": 735,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "settings": [
    {
      "name": "startTime",
      "display": "Starting Clock",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 946684800,
      "description": "The date and time the game reads when it starts, in seconds since 1970 (Unix time), in UTC; it then runs with the frames. The default is the first of January 2000. OpenBOR's own random numbers do not depend on it, but a game's scripts can read the date. It is part of the machine, so a movie needs the same value."
    }
  ],
  "firmware": [],
  "input": {
    "name": "OpenBOR",
    "_comment": "Four players, each with OpenBOR's eleven controls: the directions, the four attacks, Jump, Special and Start. Each presses the key OpenBOR's default setup has for it (player 1's are upstream's; players 2 to 4, whose upstream defaults are no keys at all, get keys by patch 0001). Start pauses a game; Escape goes back in OpenBOR's menus and leaves its pause menu. A game's own options menu can bind a control to another key; the control then no longer reaches the game until the key is bound back (Saves/<game>.cfg keeps the binding).",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Attack",
      "P1 Attack 2",
      "P1 Attack 3",
      "P1 Attack 4",
      "P1 Jump",
      "P1 Special",
      "P1 Start",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "P2 Attack",
      "P2 Attack 2",
