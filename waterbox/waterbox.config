      "P2 Jump",
      "P2 Special",
      "P2 Start",
      "P3 Up",
      "P3 Down",
      "P3 Left",
      "P3 Right",
      "P3 Attack",
      "P3 Attack 2",
      "P3 Attack 3",
      "P3 Attack 4",
      "P3 Jump",
      "P3 Special",
      "P3 Start",
      "P4 Up",
      "P4 Down",
